# --- pnpm behaviour ---------------------------------------------------------
# 项目用 pnpm。版本在 package.json 的 `packageManager` 里钉死（pnpm 会据此
# 自动切到对应版本）；`engines.pnpm` 是给不认那个字段的工具看的第二道声明。
#
# 项目级设置（依赖构建脚本白名单等）在 pnpm-workspace.yaml 里，**不在这里**
# —— pnpm 11 起 `allowBuilds` 取代了 `onlyBuiltDependencies` 一族，而该键只认
#    pnpm-workspace.yaml；写进 .npmrc 会被当作未知配置**静默忽略**。
#
# node_modules 布局保持 pnpm 默认的 isolated（符号链接 + 内容寻址 store）。
# 不需要 `node-linker=hoisted`：electron-builder 26 有专门的 pnpm 收集器
# （app-builder-lib/out/node-module-collector/pnpmNodeModulesCollector.js），
# 它按 pnpm 的依赖图决定往 asar 里放什么。改成 hoisted 只会丢掉 pnpm 的
# 依赖隔离，换不来任何东西。
fund=false

# --- Electron binary mirrors (mainland China) -------------------------------
# GitHub Actions runners reach the upstream CDNs directly, so these stay off by
# default. Enable locally when `pnpm install` stalls downloading the Electron
# binary (the `postinstall` hook runs `install-electron`):
#
#   electron_mirror=https://npmmirror.com/mirrors/electron/
#   electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
#
# Equivalent one-liner without editing this file:
#   ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ pnpm install
